# Everything generated lands here: images, serial logs, variant builds.
build/

# Objects and libraries, including the ones the third party trees drop next to
# their own sources.
*.o
*.a

# What the compiler read to build each object, written beside it by -MMD. The
# ones under build/ are covered by that rule; this is here because the host
# tests and the tools write their own, next to their sources
*.d

# Host side test binaries.
#
# By pattern rather than by name: a written out list has gone stale three
# times, and it shows up as a binary that differs after every build rather
# than as an error. The sources are taken back out afterwards.
tests/unit/test_*
!tests/unit/test_*.c
tests/tools/peprobe
tests/tools/planprobe
tests/tools/holes
tests/tools/blobcheck

# The same in the third party trees.
third_party/posix-uefi/tests/test_printf
third_party/posix-uefi/tests/test_strtol
third_party/toml-c/tests/test_toml

__pycache__/

# The interpreter the screen reader's text engine is installed in. It is a
# recogniser and an ONNX runtime, which is not something to require of every
# machine that runs a check, so it lives here rather than in a requirement
# file: the checks that only look at colours work without it.
tests/deploy/venv/

# Editor state, not project configuration.
.vscode/

# Harness state, not part of the project.
.dsh/

# Serial captures from serial_tcp.py and serial_ntoseye.py. A boot's worth of
# them is large, and the crate is the project.
kd-*.log
*.sock
*.sock.in
*.sock.out

# The demo programs are built here, but what is kept is their source.
tests/demo/*.exe
tests/demo/*.lib
